# Git's standard cross-platform setting: the repository stores LF, and working copies use the
# platform's native ending (CRLF on Windows). Content parsing must therefore cope with both.
* text=auto

# Shell scripts must stay LF on every platform.
*.sh text eol=lf

# Visual Studio expects CRLF solution files.
*.sln text eol=crlf

# Windows-only scripts
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.dll binary
*.exe binary
